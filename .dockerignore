.git
.review
.env*
**/*.log
**/*.backup

database-config/connection.php
database-config/local.php
database-config/runtime

node_modules
vendor

# Ignore uploaded content by default
uploaded-content/*

# Keep the web protection file
!uploaded-content/.htaccess

# Include organiser/company profile pictures in Render deployments
!uploaded-content/profile-pictures/
!uploaded-content/profile-pictures/*.png

# Include event banner images in Render deployments
!uploaded-content/event-banners/
!uploaded-content/event-banners/*.png
!uploaded-content/event-banners/*.jpg

# Include organiser post photos in Render deployments
!uploaded-content/posts/
!uploaded-content/posts/*.jpg
!uploaded-content/posts/*.jpeg
!uploaded-content/posts/*.png

# Include career field images in Render deployments
!uploaded-content/category-images/
!uploaded-content/category-images/*.png
!uploaded-content/category-images/*.jpg
