Options -Indexes
RewriteEngine On

# Keep source control, environment files and internal audit files private.
RewriteRule ^(?:\.git|\.review|database|vendor)(?:/|$) - [F,L,NC]
<FilesMatch "(?i)(^\.env|\.(sql|md|log|json|lock|backup)$|^Dockerfile$)">
    Require all denied
</FilesMatch>

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]
