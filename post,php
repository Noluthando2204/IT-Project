<?php
/**
 * post.php
 * Root-level standalone backend handler. Uploaded media goes to uploaded-content/.
 *
 * Purpose: Validate, save and delete organiser event-linked posts.
 *
 * Receives from:
 *  - create-post.php sends EventID, Content, optional Media, Media_type, Hashtags.
 *  - Organiser management may send PostID for deletion.
 *
 * Required behaviour:
 *  - Require an approved organiser and verify the selected EventID belongs to them.
 *  - Insert Content, safe Media path, nullable Media_type, normalised Hashtags,
 *    session OrganizerID, selected EventID, PostDate.
 *  - Support text-only updates, images and videos. Reject unsupported media
 *    types and unsafe filenames.
 *  - For deletion, verify POSTS.OrganizerID before deleting, and handle linked
 *    REACTIONS / Post_Categories safely within the relationship rules.
 *  - No public comments or unrelated standalone posts (not implemented here).
 *
 * Links to / returns to: create-post.php / business-dashboard.php after save,
 * organiser-posts.php / post-detail.php for public viewing after allowed event status.
 */
 
require_once __DIR__ . '/shared-components/auth.php';
require_once __DIR__ . '/shared-components/functions.php';
require_once __DIR__ . '/database-config/connection.php';
 
 
/*
|--------------------------------------------------------------------------
| TEMPORARY LOCAL HELPERS
|--------------------------------------------------------------------------
| shared-components/auth.php currently only checks that $_SESSION['user_id']
| is set (its own comment says role/permission checks are "for later").
| shared-components/functions.php currently only has sanitizeInput() and
| generateBookingReference(). Neither file yet provides role checks, CSRF,
| or money/date/hashtag formatting helpers.
|
| Until the team adds those to the real shared files (per the guide's rule
| that shared-file changes need team agreement), this file does its own
| role check and formatting locally. If auth.php/functions.php gain proper
| versions of these later, delete this block and call the shared ones.
|--------------------------------------------------------------------------
*/
function local_require_role(PDO $pdo, array $allowed_roles, bool $require_approved = false): array
{
    $user_id = (int) ($_SESSION['user_id'] ?? 0);
    $stmt = $pdo->prepare("SELECT UserID, Role, RoleStatus FROM USERS WHERE UserID = :user_id");
    $stmt->execute([':user_id' => $user_id]);
    $user = $stmt->fetch(PDO::FETCH_ASSOC);
 
    if (!$user || !in_array($user['Role'], $allowed_roles, true)) {
        header('Location: /login.php');
        exit;
    }
    if ($require_approved && $user['RoleStatus'] !== 'approved') {
        header('Location: /login.php');
        exit;
    }
    return $user;
}
 
function local_csrf_token(): string
{
    if (empty($_SESSION['csrf_token'])) {
        $_SESSION['csrf_token'] = bin2hex(random_bytes(32));
    }
    return $_SESSION['csrf_token'];
}
 
function local_verify_csrf(string $token): bool
{
    return isset($_SESSION['csrf_token']) && hash_equals($_SESSION['csrf_token'], $token);
}
 
function local_format_money($amount): string
{
    return 'R' . number_format((float) $amount, 2);
}
 
function local_format_datetime($dt): string
{
    return $dt ? date('d M Y, H:i', strtotime($dt)) : '';
}
 
function local_status_badge(string $status): array
{
    $map = [
        'draft' => 'badge-grey', 'pending' => 'badge-grey',
        'published' => 'badge-green', 'paid' => 'badge-green', 'confirmed' => 'badge-green', 'success' => 'badge-green', 'released' => 'badge-green',
        'completed' => 'badge-blue', 'free' => 'badge-blue',
        'cancelled' => 'badge-red', 'failed' => 'badge-red',
        'refunded' => 'badge-orange', 'held' => 'badge-orange', 'rejected' => 'badge-red', 'approved' => 'badge-green',
    ];
    return ['label' => ucfirst($status), 'class' => $map[$status] ?? 'badge-grey'];
}
 
function local_normalize_hashtags(string $raw): string
{
    $parts = preg_split('/[\s,]+/', trim($raw));
    $clean = array_filter(array_map(function ($t) {
        $t = preg_replace('/[^A-Za-z0-9_]/', '', $t);
        return $t !== '' ? '#' . ltrim($t, '#') : null;
    }, $parts ?: []));
    return implode(' ', array_unique($clean));
}
 
 
if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
    http_response_code(405);
    exit('Method not allowed.');
}
 
$organizer_id = local_require_role($pdo, ['organizer'], true)['UserID'];
 
if (!local_verify_csrf($_POST['csrf_token'] ?? '')) {
    header('Location: create-post.php?post=error');
    exit;
}
 
$action = $_POST['action'] ?? 'create';
 
if ($action === 'delete') {
    handle_post_delete($pdo, $organizer_id);
    exit;
}
 
handle_post_create($pdo, $organizer_id);
exit;
 
/**
 * Validate and insert a new post, linked to an event the organiser owns.
 */
function handle_post_create(PDO $pdo, int $organizer_id): void
{
    $event_id = filter_var($_POST['EventID'] ?? null, FILTER_VALIDATE_INT);
    $content = trim((string) ($_POST['Content'] ?? ''));
 
    if ($event_id === false || $event_id <= 0 || $content === '') {
        header('Location: create-post.php?post=error');
        exit;
    }
 
    // Verify the event belongs to this organiser — never trust the submitted EventID alone.
    $owns_stmt = $pdo->prepare("SELECT EventID FROM EVENTS WHERE EventID = :event_id AND OrganizerID = :organizer_id");
    $owns_stmt->execute([':event_id' => $event_id, ':organizer_id' => $organizer_id]);
    if (!$owns_stmt->fetch()) {
        header('Location: create-post.php?post=error');
        exit;
    }
 
    $media_path = null;
    $media_type = null;
 
    if (!empty($_FILES['Media']['name'])) {
        $upload_result = save_post_media($_FILES['Media']);
        if ($upload_result === null) {
            // Unsafe filename, unsupported type, or upload error.
            header('Location: create-post.php?post=error');
            exit;
        }
        [$media_path, $media_type] = $upload_result;
    }
    // If no media was uploaded, Media/Media_type stay NULL — a valid text-only update.
 
    $hashtags = local_normalize_hashtags((string) ($_POST['Hashtags'] ?? ''));
    $content = mb_substr($content, 0, 2000);
 
    $insert = $pdo->prepare(
        "INSERT INTO POSTS (Content, Media, Media_type, Hashtags, PostDate, OrganizerID, EventID)
         VALUES (:content, :media, :media_type, :hashtags, NOW(), :organizer_id, :event_id)"
    );
    $insert->execute([
        ':content' => $content,
        ':media' => $media_path,
        ':media_type' => $media_type,
        ':hashtags' => $hashtags,
        ':organizer_id' => $organizer_id,
        ':event_id' => $event_id,
    ]);
 
    header('Location: business-dashboard.php?post=success');
}
 
/**
 * Verify ownership, then delete a post and its safely-cleanable dependents.
 */
function handle_post_delete(PDO $pdo, int $organizer_id): void
{
    $post_id = filter_var($_POST['PostID'] ?? null, FILTER_VALIDATE_INT);
 
    if ($post_id === false || $post_id <= 0) {
        header('Location: business-dashboard.php?post=error');
        exit;
    }
 
    $owns_stmt = $pdo->prepare("SELECT PostID FROM POSTS WHERE PostID = :post_id AND OrganizerID = :organizer_id");
    $owns_stmt->execute([':post_id' => $post_id, ':organizer_id' => $organizer_id]);
 
    if (!$owns_stmt->fetch()) {
        header('Location: business-dashboard.php?post=error');
        exit;
    }
 
    $pdo->beginTransaction();
    try {
        // Clean up dependent rows the ERD allows to be cleaned when a post is
        // deliberately removed (per Cynthia-approved ON DELETE handling for
        // Post_Categories and REACTIONS).
        $pdo->prepare("DELETE FROM REACTIONS WHERE PostID = :post_id")
            ->execute([':post_id' => $post_id]);
        $pdo->prepare("DELETE FROM Post_Categories WHERE post_id = :post_id")
            ->execute([':post_id' => $post_id]);
        $pdo->prepare("DELETE FROM POSTS WHERE PostID = :post_id AND OrganizerID = :organizer_id")
            ->execute([':post_id' => $post_id, ':organizer_id' => $organizer_id]);
 
        $pdo->commit();
    } catch (PDOException $e) {
        $pdo->rollBack();
        error_log('post.php delete failed: ' . $e->getMessage());
        header('Location: business-dashboard.php?post=error');
        exit;
    }
 
    header('Location: business-dashboard.php?post=deleted');
}
 
/**
 * Validate an uploaded media file and move it into uploaded-content/.
 * Returns [safe_relative_path, media_type] or null on any validation failure.
 *
 * @return array{0:string,1:string}|null
 */
function save_post_media(array $file): ?array
{
    if ($file['error'] !== UPLOAD_ERR_OK) {
        return null;
    }
 
    $allowed = [
        'image/jpeg' => ['ext' => 'jpg', 'type' => 'image'],
        'image/png' => ['ext' => 'png', 'type' => 'image'],
        'image/webp' => ['ext' => 'webp', 'type' => 'image'],
        'video/mp4' => ['ext' => 'mp4', 'type' => 'video'],
        'video/webm' => ['ext' => 'webm', 'type' => 'video'],
    ];
 
    $finfo = finfo_open(FILEINFO_MIME_TYPE);
    $mime = finfo_file($finfo, $file['tmp_name']);
    finfo_close($finfo);
 
    if (!isset($allowed[$mime])) {
        return null;
    }
 
    // 25MB cap, generous enough for short clips while bounding storage/abuse.
    if ($file['size'] > 25 * 1024 * 1024) {
        return null;
    }
 
    $safe_name = bin2hex(random_bytes(16)) . '.' . $allowed[$mime]['ext'];
    $destination_dir = __DIR__ . '/uploaded-content/';
    $destination = $destination_dir . $safe_name;
 
    if (!is_dir($destination_dir) || !move_uploaded_file($file['tmp_name'], $destination)) {
        return null;
    }
 
    return ['uploaded-content/' . $safe_name, $allowed[$mime]['type']];
}
 
